{
  "name": "@iamken/cloudtunnel",
  "version": "0.1.1",
  "description": "Manage Cloudflare Tunnels and subdomains account-wide from the CLI — instant HTTPS sharing on your own domains.",
  "type": "module",
  "bin": {
    "cloudtunnel": "dist/index.js",
    "ct": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cloudflare",
    "tunnel",
    "cloudflared",
    "cli",
    "ngrok",
    "subdomain"
  ],
  "license": "MIT",
  "author": "thanhken <admin@iamken.work>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thanhken/cloudtunnel.git"
  },
  "homepage": "https://github.com/thanhken/cloudtunnel#readme",
  "bugs": {
    "url": "https://github.com/thanhken/cloudtunnel/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "env-paths": "^3.0.0",
    "picocolors": "^1.1.1",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
